{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afadlih/afadlih/blob/main/schemas/public-commit-activity.schema.json",
  "title": "Generated public commit activity sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "username",
    "source",
    "sample_limit_per_repository",
    "latest_public_commit_at",
    "window",
    "summary",
    "daily",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "source": {
      "const": "GitHub public commit API sample"
    },
    "sample_limit_per_repository": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "latest_public_commit_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "days"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "days": {
          "const": 30
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampled_commits",
        "commits_in_window",
        "active_days",
        "repositories_with_commits"
      ],
      "properties": {
        "sampled_commits": {
          "type": "integer",
          "minimum": 1
        },
        "commits_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "active_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "repositories_with_commits": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "daily": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "commits"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "commits": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "sampled_commits"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "sampled_commits": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
