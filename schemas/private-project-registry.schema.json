{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afadlih/afadlih/blob/main/schemas/private-project-registry.schema.json",
  "title": "Approved private project public metadata registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "enabled",
          "condition",
          "condition_strategy",
          "public_summary",
          "focus",
          "case_study",
          "profile_link",
          "show_in_current_focus",
          "version_source"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "enabled": {
            "type": "boolean"
          },
          "condition": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "public_summary": {
            "type": "string",
            "minLength": 30,
            "maxLength": 300
          },
          "focus": {
            "type": "string",
            "minLength": 30,
            "maxLength": 350
          },
          "case_study": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^case-studies/[a-z0-9-]+/README\\.md$"
          },
          "profile_link": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^case-studies/[a-z0-9-]+/README\\.md$"
          },
          "show_in_current_focus": {
            "type": "boolean"
          },
          "version_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "strategy"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
              },
              "strategy": {
                "enum": [
                  "json",
                  "regex"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "pattern": {
                "type": "string",
                "minLength": 5,
                "maxLength": 300
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "strategy": {
                      "const": "json"
                    }
                  }
                },
                "then": {
                  "required": [
                    "field"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "strategy": {
                      "const": "regex"
                    }
                  }
                },
                "then": {
                  "required": [
                    "pattern"
                  ]
                }
              }
            ]
          },
          "condition_strategy": {
            "enum": [
              "fixed",
              "semver"
            ]
          }
        }
      }
    }
  }
}
