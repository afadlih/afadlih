{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afadlih/afadlih/blob/main/schemas/projects.schema.json",
  "title": "Curated project records",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "projects"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "projects": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "title", "status", "profile_section", "visibility", "category", "priority", "role", "summary", "problem", "outcome", "technologies", "proof_points", "feature_deep_dives", "links", "limitations", "proof_level"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 2},
          "title": {"type": "string", "minLength": 2},
          "status": {"enum": ["draft", "active", "featured", "stable", "archived"]},
          "profile_section": {"enum": ["featured", "major", "supporting", "archive"]},
          "visibility": {"enum": ["public", "private"]},
          "category": {"type": "string", "minLength": 3},
          "priority": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "minLength": 3},
          "summary": {"type": "string", "minLength": 30},
          "problem": {"type": "string", "minLength": 30},
          "outcome": {"type": "string", "minLength": 30},
          "technologies": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "proof_points": {"type": "array", "items": {"type": "string", "minLength": 12}},
          "feature_deep_dives": {"type": "array", "items": {"type": "string", "minLength": 8}},
          "links": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "case_study", "demo", "video"],
            "properties": {
              "repository": {"type": ["string", "null"], "format": "uri"},
              "case_study": {"type": ["string", "null"]},
              "demo": {"type": ["string", "null"], "format": "uri"},
              "video": {"type": ["string", "null"], "format": "uri"}
            }
          },
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}},
          "proof_level": {"enum": ["documented-private", "source-verifiable", "public-repository", "funded-prototype"]},
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cover", "architecture", "workflow", "extra"],
            "properties": {
              "cover": {"type": ["string", "null"]},
              "architecture": {"type": ["string", "null"]},
              "workflow": {"type": ["string", "null"]},
              "extra": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
