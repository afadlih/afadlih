{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afadlih/afadlih/blob/main/schemas/profile.schema.json",
  "title": "Special GitHub profile data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "name",
    "short_name",
    "username",
    "role",
    "headline",
    "location",
    "portfolio_url",
    "github_url",
    "linkedin_url",
    "availability",
    "focus_areas",
    "current_focus",
    "education",
    "experience",
    "recognition",
    "engineering_principles",
    "profile_notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "short_name": {
      "type": "string",
      "minLength": 2
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "role": {
      "type": "string",
      "minLength": 20
    },
    "headline": {
      "type": "string",
      "minLength": 30
    },
    "location": {
      "type": "string",
      "minLength": 2
    },
    "portfolio_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "github_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/"
    },
    "linkedin_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "availability": {
      "type": "string",
      "minLength": 20
    },
    "focus_areas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "current_focus": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "version",
          "condition",
          "updated",
          "focus",
          "link"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 2
          },
          "version": {
            "type": "string",
            "minLength": 2
          },
          "condition": {
            "type": "string",
            "minLength": 3
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "focus": {
            "type": "string",
            "minLength": 30
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization",
          "title",
          "period",
          "summary"
        ],
        "properties": {
          "organization": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "recognition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "project",
          "summary"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "engineering_principles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "profile_notes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "institution",
          "english_name",
          "program",
          "department",
          "status",
          "location",
          "summary",
          "official_url"
        ],
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 3
          },
          "english_name": {
            "type": "string",
            "minLength": 3
          },
          "program": {
            "type": "string",
            "minLength": 3
          },
          "department": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "minLength": 3
          },
          "location": {
            "type": "string",
            "minLength": 3
          },
          "summary": {
            "type": "string",
            "minLength": 30
          },
          "official_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
