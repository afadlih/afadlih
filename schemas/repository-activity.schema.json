{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afadlih/afadlih/blob/main/schemas/repository-activity.schema.json",
  "title": "Generated public repository activity snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "as_of", "source", "items"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "source": {"const": "GitHub repository metadata"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repository", "url", "description", "language", "pushed_at"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
          "description": {"type": ["string", "null"]},
          "language": {"type": ["string", "null"]},
          "pushed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
